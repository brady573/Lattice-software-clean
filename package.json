{
  "name": "lattice-software",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "dev:prototype": "tsx src/development/index.ts",
    "worker:run": "node dist/src/run-worker-main.js",
    "worker:research": "node dist/src/research-worker-main.js",
    "android:model-worker": "node tools/android-model-worker.mjs",
    "benchmark:local-model": "node tools/local-model-ab-benchmark.mjs",
    "proof:knowledge:live": "npm run build && node tools/live-knowledge-consultation-proof.mjs",
    "qualify:live-provider": "node tools/live-provider-qualification.mjs",
    "qualify:live-provider:render": "node tools/render-live-provider-qualification.mjs",
    "db:migrate": "npm run build && node dist/src/migrate.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "fastify": "^5.5.0",
    "pg": "8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
