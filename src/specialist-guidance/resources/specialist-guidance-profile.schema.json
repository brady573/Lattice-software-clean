{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Prototype Specialist Guidance Profile schema. Profile hashing uses lattice-json-v1 canonical JSON (lexicographically sorted object keys, array order preserved, UTF-8, no insignificant whitespace) and SHA-256; the hash is derived audit metadata and is not embedded in the resource.",
  "properties": {
    "activationScope": { "items": { "type": "string" }, "minItems": 1, "type": "array" },
    "authorityBoundary": { "items": { "type": "string" }, "minItems": 1, "type": "array" },
    "clarificationGuidance": { "items": { "type": "string" }, "type": "array" },
    "domain": { "minLength": 1, "type": "string" },
    "evaluationCorpusId": { "minLength": 1, "type": "string" },
    "excludedScopes": { "items": { "type": "string" }, "type": "array" },
    "presentationGuidance": { "items": { "type": "string" }, "type": "array" },
    "procedure": { "items": { "type": "string" }, "minItems": 1, "type": "array" },
    "profileId": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" },
    "purpose": { "minLength": 1, "type": "string" },
    "securityBoundary": { "items": { "type": "string" }, "minItems": 1, "type": "array" },
    "userFacingLabel": { "minLength": 1, "type": "string" },
    "version": { "minimum": 1, "type": "integer" }
  },
  "required": [
    "profileId",
    "version",
    "userFacingLabel",
    "domain",
    "purpose",
    "activationScope",
    "procedure",
    "clarificationGuidance",
    "excludedScopes",
    "presentationGuidance",
    "authorityBoundary",
    "securityBoundary",
    "evaluationCorpusId"
  ],
  "title": "SpecialistGuidanceProfilePrototype",
  "type": "object"
}
